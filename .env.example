# Optional overrides for `docker compose`. Copy to .env to change them.
# POSTGRES_PORT=5433
# API_PORT=8000
# WEB_PORT=5173

# Generate a real value with: openssl rand -base64 48
# JWT_SECRET=

# Needed only when running the backend or its tests outside Docker:
# DATABASE_URL=postgresql+psycopg://coursepilot:coursepilot@localhost:5433/coursepilot
# COOKIE_SECURE=false
